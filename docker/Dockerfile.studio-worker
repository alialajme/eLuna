# syntax=docker/dockerfile:1
#
# AI Studio worker image: a long-running background process that drains the
# transactional outbox and runs generation jobs (packages/studio/src/worker.ts).
# Deployed as its own AKS Deployment (templates/studio-worker.yaml) so expensive
# AI generation runs OFF the web request path. Without this, the apps enqueue
# generation jobs but nothing consumes them in production.

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl && corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# Isolate just the @ayvana/studio package subset (pulls in its workspace deps:
# db, fashion, storage, observability, config).
FROM base AS pruner
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune "@ayvana/studio" --docker

# Install deps (incl. tsx + prisma devDeps) + generate the Prisma client.
FROM base AS worker
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter "@ayvana/db" exec prisma generate

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
USER worker

# DATABASE_URL + provider keys are injected at runtime (Key Vault CSI). The
# worker loops forever, claiming outbox events (FOR UPDATE SKIP LOCKED) and
# running the generation pipeline. Keyless: without provider keys it uses the
# Simulated gateways (never crashes on a missing key).
CMD ["pnpm", "--filter", "@ayvana/studio", "worker"]
