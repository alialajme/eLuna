generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPLIER
}

enum MfaMethod {
  SMS
  TOTP
  WEBAUTHN
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SupplierStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MaterialStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MaterialUnit {
  METER
  YARD
  ROLL
  PIECE
  SPOOL
}

enum MaterialOrderStatus {
  PENDING
  ACCEPTED
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
  REFUNDED
}

enum MaterialReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum TradeLicenseStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentMethod {
  CARD
  LUNA_WALLET
  TABBY
  TAMARA
  CASH_ON_DELIVERY
  TAP
  NOQODI
  NEOPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Immutable AYVANA Wallet ledger. Every balance movement is one append-only row;
// balance history is never mutated — corrections are new REVERSAL/ADJUSTMENT rows.
enum WalletTxnType {
  CREDIT // funds added (top-up, cashback, refund credit)
  DEBIT // funds spent (checkout)
  REFUND // funds returned to wallet from a refunded order
  REVERSAL // reverses a prior DEBIT (e.g. cancelled order)
  ADJUSTMENT // manual admin correction
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Immutable marketplace financial ledger. Append-only record of money movements
// (signed `amount`: credit positive, debit negative). Never updated/deleted —
// corrections are new reversing/adjustment rows.
enum LedgerEntryType {
  SALE // vendor net revenue accrued from a delivered order item
  COMMISSION // platform commission taken from a sale
  REFUND // reversal of vendor revenue when an order item is refunded
  PAYOUT // funds paid out to a vendor
  ADJUSTMENT // manual correction
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum AIAgentType {
  SHOPPING
  SELLER
  STUDIO
  LOGISTICS
  PAYMENT
  POS
  SUPPLIER
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  PROMOTION
  AI_SUGGESTION
  SYSTEM
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id         String     @id // Clerk user ID
  email      String     @unique
  role       UserRole
  mfaEnabled Boolean    @default(false)
  mfaMethod  MfaMethod?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customerProfile CustomerProfile?
  vendor          Vendor?
  supplier        Supplier?
  addresses       Address[]
  aiSessions      AISession[]
  notifications   Notification[]
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model CustomerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  loyaltyPoints Int      @default(0)
  walletBalance Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sizeProfile        SizeProfile?
  orders             Order[]
  wishlists          Wishlist[]
  reviews            Review[]
  walletTransactions WalletTransaction[]
}

model SizeProfile {
  id                   String   @id @default(cuid())
  customerProfileId    String   @unique
  // Body measurements (cm)
  height               Float?
  weight               Float?
  bust                 Float?
  waist                Float?
  hip                  Float?
  shoulder             Float?
  // Garment preferences
  sleeveLength         String? // SHORT | THREE_QUARTER | FULL
  preferredAbayaLength String? // MIDI | MAXI | FLOOR
  fitPreference        String? // FITTED | REGULAR | LOOSE | OVERSIZED
  usualSize            String? // XS | S | M | L | XL | XXL | 3XL
  sizeSystem           String?  @default("INTL") // INTL | US | UK | EU | GCC
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// VENDOR
// ─────────────────────────────────────────────

model Vendor {
  id             String       @id @default(cuid())
  userId         String       @unique
  storeName      String
  storeSlug      String       @unique
  description    String?
  logoUrl        String?
  bannerUrl      String?
  status         VendorStatus @default(PENDING)
  commissionRate Decimal      @default(0.15) @db.Decimal(4, 2)
  ibanNumber     String?
  trn            String?
  mfaVerifiedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  orderItems         OrderItem[]
  payouts            Payout[]
  studioUploads      StudioUpload[]
  shipments          Shipment[]
  materialOrders     MaterialOrder[]
  orderInvoices      OrderInvoice[]
  ledgerEntries      LedgerEntry[]
  materialReturns    MaterialReturn[]
  garmentAssets      GarmentAsset[]
  aiModelProfiles    AIModelProfile[]
  generationSessions GenerationSession[]
  creditWallet       CreditWallet?
  studioSubscription StudioSubscription?

  @@index([status])
}

model Supplier {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  companyName            String
  companySlug            String             @unique
  description            String?
  logoUrl                String?
  bannerUrl              String?
  status                 SupplierStatus     @default(PENDING)
  materialTypes          String[]
  ibanNumber             String?
  trn                    String?
  mfaVerifiedAt          DateTime?
  // UAE trade-licence verification (credential-gated registry integration).
  tradeLicenseNumber     String?
  tradeLicenseStatus     TradeLicenseStatus @default(UNVERIFIED)
  tradeLicenseExpiry     DateTime?
  tradeLicenseVerifiedAt DateTime?
  tradeLicenseRef        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials         Material[]
  materialOrders    MaterialOrder[]
  invoices          MaterialInvoice[]
  dropshipProducts  Product[]         @relation("SupplierDropshipProducts")
  customerShipments Shipment[]        @relation("SupplierCustomerShipments")
  payouts           SupplierPayout[]
  materialReturns   MaterialReturn[]

  @@index([status])
}

model Material {
  id             String         @id @default(cuid())
  supplierId     String
  name           String
  slug           String         @unique
  materialType   String
  color          String?
  composition    String?
  unit           MaterialUnit
  wholesalePrice Decimal        @db.Decimal(10, 2)
  moq            Int            @default(1)
  stock          Int            @default(0)
  description    String?
  images         Json           @default("[]")
  status         MaterialStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderItems MaterialOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([supplierId, status])
}

model MaterialOrder {
  id             String              @id @default(cuid())
  vendorId       String
  supplierId     String
  status         MaterialOrderStatus @default(PENDING)
  total          Decimal             @db.Decimal(10, 2)
  note           String?
  trackingNote   String?
  courier        String?
  trackingNumber String?
  externalRef    String?
  labelUrl       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          MaterialOrderItem[]
  invoice        MaterialInvoice?
  materialReturn MaterialReturn?

  @@index([vendorId])
  @@index([supplierId])
  @@index([supplierId, status])
  @@index([vendorId, status])
}

// Buyer-initiated return/RMA on a fulfilled material order. Order-level (one per
// order) — material orders are single-line quick orders today. The buying vendor
// requests; the selling supplier approves → receives → refunds. On REFUNDED the
// parent MaterialOrder flips to REFUNDED, which drops its total from the
// supplier's `earned` balance (see computeSupplierBalance). No payment moved
// (PO-record model — wholesale settlement is offline), so `refundAmount` is a
// bookkeeping snapshot of the reversed order total.
model MaterialReturn {
  id             String               @id @default(cuid())
  orderId        String               @unique
  vendorId       String
  supplierId     String
  status         MaterialReturnStatus @default(REQUESTED)
  reason         String
  quantity       Int
  refundAmount   Decimal              @db.Decimal(10, 2)
  isRestocked    Boolean              @default(false)
  resolutionNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  order    MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor        @relation(fields: [vendorId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([vendorId])
  @@index([supplierId, status])
}

model MaterialOrderItem {
  id           String       @id @default(cuid())
  orderId      String
  materialId   String?
  materialName String
  unit         MaterialUnit
  unitPrice    Decimal      @db.Decimal(10, 2)
  quantity     Int

  order    MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([materialId])
}

model MaterialInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  materialOrderId String        @unique
  supplierId      String
  vendorId        String
  supplierName    String
  supplierTRN     String
  vendorName      String
  status          InvoiceStatus @default(ISSUED)
  subtotal        Decimal       @db.Decimal(10, 2)
  vatRate         Decimal       @default(0.05) @db.Decimal(4, 2)
  vatAmount       Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  lines           Json
  externalRef     String?
  issuedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())

  order    MaterialOrder @relation(fields: [materialOrderId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([supplierId, issuedAt])
}

model OrderInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String
  vendorId      String
  vendorName    String
  vendorTRN     String
  customerName  String
  subtotal      Decimal  @db.Decimal(10, 2)
  vatRate       Decimal  @default(0.05) @db.Decimal(4, 2)
  vatAmount     Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  lines         Json
  externalRef   String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([orderId, vendorId])
  @@index([vendorId])
  @@index([vendorId, issuedAt])
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id                 String        @id @default(cuid())
  vendorId           String
  title              String
  slug               String        @unique
  description        String?
  price              Decimal       @db.Decimal(10, 2)
  compareAt          Decimal?      @db.Decimal(10, 2)
  category           String
  fabric             String?
  careGuide          String?
  aiImages           Json          @default("[]")
  sizeGuide          Json          @default("{}")
  status             ProductStatus @default(DRAFT)
  dropshipSupplierId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dropshipSupplier   Supplier?           @relation("SupplierDropshipProducts", fields: [dropshipSupplierId], references: [id])
  variants           ProductVariant[]
  wishlists          Wishlist[]
  reviews            Review[]
  garmentAssets      GarmentAsset[]
  generationSessions GenerationSession[]

  @@index([vendorId])
  @@index([status])
  @@index([vendorId, status])
  @@index([dropshipSupplierId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String
  color     String
  sku       String   @unique
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  returns    Return[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String? // Home | Work | etc.
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  emirate      String? // UAE-specific
  country      String   @default("AE")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id            String        @id @default(cuid())
  customerId    String
  addressId     String
  status        OrderStatus   @default(PENDING)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer            CustomerProfile      @relation(fields: [customerId], references: [id])
  address             Address              @relation(fields: [addressId], references: [id])
  items               OrderItem[]
  shipments           Shipment[]
  paymentTransactions PaymentTransaction[]
  invoices            OrderInvoice[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  variantId         String
  vendorId          String
  shipmentId        String?
  quantity          Int
  unitPrice         Decimal           @db.Decimal(10, 2)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  shipment Shipment?      @relation(fields: [shipmentId], references: [id])
  returns  Return[]

  @@index([orderId])
  @@index([variantId])
  @@index([vendorId])
  @@index([shipmentId])
  @@index([orderId, fulfillmentStatus])
}

// ─────────────────────────────────────────────
// RETURNS
// ─────────────────────────────────────────────

model Return {
  id            String       @id @default(cuid())
  orderItemId   String
  variantId     String
  status        ReturnStatus @default(REQUESTED)
  reason        String
  approvalNotes String?
  refundAmount  Decimal      @db.Decimal(10, 2)
  isRestocked   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderItemId])
  @@index([status])
}

// ─────────────────────────────────────────────
// LOGISTICS
// ─────────────────────────────────────────────

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  vendorId          String
  courier           String
  trackingNumber    String?
  externalRef       String?
  labelUrl          String?
  status            ShipmentStatus @default(CREATED)
  supplierId        String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  cost              Decimal        @default(0) @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor      @relation(fields: [vendorId], references: [id])
  supplier Supplier?   @relation("SupplierCustomerShipments", fields: [supplierId], references: [id])
  items    OrderItem[]

  @@index([orderId])
  @@index([vendorId])
  @@index([supplierId])
  @@index([status])
  @@index([trackingNumber])
  @@index([externalRef])
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model PaymentTransaction {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("AED")
  externalRef String? // Stripe/Tabby/Tamara payment ID
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Restrict prevents accidental deletion of financial audit records
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

// Append-only wallet ledger. Rows are never updated or deleted (financial audit
// trail). `balanceAfter` snapshots the wallet balance immediately after this
// movement so the ledger is self-verifying and reconcilable against
// CustomerProfile.walletBalance.
model WalletTransaction {
  id                String        @id @default(cuid())
  customerProfileId String
  type              WalletTxnType
  amount            Decimal       @db.Decimal(10, 2) // always positive; `type` carries the sign
  balanceAfter      Decimal       @db.Decimal(10, 2)
  orderId           String? // set for DEBIT/REFUND/REVERSAL tied to an order
  reference         String? // idempotency / external correlation
  note              String?
  createdAt         DateTime      @default(now())

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)

  @@index([customerProfileId])
  @@index([orderId])
  @@index([type])
}

model Payout {
  id          String       @id @default(cuid())
  vendorId    String
  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("AED")
  status      PayoutStatus @default(PENDING)
  ibanNumber  String
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Restrict preserves payout history when vendor is deactivated
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([status])
}

// Wholesale payouts to suppliers for fulfilled material orders. Mirrors Payout
// (no commission — supplier sales are wholesale). Immutable history (Restrict).
model SupplierPayout {
  id          String       @id @default(cuid())
  supplierId  String
  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("AED")
  status      PayoutStatus @default(PENDING)
  ibanNumber  String
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([status])
}

// Append-only marketplace financial ledger (see LedgerEntryType). Rows are
// immutable — never UPDATE or DELETE. `amount` is signed (credit +, debit −).
// Operational IDs are stored as plain strings so historical entries survive
// deletion of the referenced order/payout (audit integrity).
model LedgerEntry {
  id          String          @id @default(cuid())
  vendorId    String
  entryType   LedgerEntryType
  amount      Decimal         @db.Decimal(10, 2) // signed
  currency    String          @default("AED")
  orderId     String?
  orderItemId String?
  payoutId    String?
  note        String?
  createdAt   DateTime        @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([entryType])
  @@index([payoutId])
  @@index([orderId])
}

// Immutable security/audit log. Append-only record of sensitive actions (admin
// operations, payout/refund/vendor approvals, status & role changes, and
// suspicious authorization failures). Never UPDATE or DELETE. Store only
// non-sensitive metadata — never card data, secrets, tokens, or passwords.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // Clerk user id of the actor (null for system/anonymous)
  actorRole  String? // role at time of action
  action     String // e.g. "payout.completed", "vendor.approved", "authz.denied"
  targetType String? // e.g. "Payout", "Vendor", "Order"
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// Transactional outbox (§33–34). A domain event is written in the SAME
// transaction as the state change that produced it, so "DB committed + event
// lost" cannot happen. A worker later publishes PENDING events and marks them
// PROCESSED. `availableAt` gates retry backoff; the worker claims rows with
// FOR UPDATE SKIP LOCKED so multiple workers don't process the same event.
model OutboxEvent {
  id          String       @id @default(cuid())
  type        String // e.g. "order.confirmed", "payment.captured"
  payload     Json         @default("{}")
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  error       String?
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([type])
}

// ─────────────────────────────────────────────
// SOCIAL & ENGAGEMENT
// ─────────────────────────────────────────────

model Review {
  id                String   @id @default(cuid())
  productId         String
  customerProfileId String
  rating            Int // 1–5
  body              String?
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, productId])
  @@index([productId])
  @@index([customerProfileId])
}

model Wishlist {
  id                String   @id @default(cuid())
  customerProfileId String
  productId         String
  createdAt         DateTime @default(now())

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, productId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json             @default("{}")
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────

model AISession {
  id        String      @id @default(cuid())
  userId    String
  agentType AIAgentType
  messages  Json        @default("[]")
  context   Json        @default("{}")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentType])
  @@index([userId])
}

// ─────────────────────────────────────────────
// STUDIO
// ─────────────────────────────────────────────

model StudioUpload {
  id              String   @id @default(cuid())
  vendorId        String
  sourceImages    Json     @default("[]") // URLs of 3 uploaded photos
  generatedAssets Json     @default("{}") // AI-generated images, video, copy
  status          String   @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED
  productId       String? // Linked product if created
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ─────────────────────────────────────────────
// PLATFORM SETTINGS
// ─────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────
// AI FASHION STUDIO (Phase 1 — foundation)
//
// Productionizes the stubbed Phase 5 Studio. New models use UUID PKs (the
// feature standard, per the Phase 0 ADR §11); existing models use cuid().
// Money is Decimal, never float. Every asset chains to a vendorId for strict
// seller/org isolation — Seller A can never read Seller B's garments/sessions/
// assets. Billing (credits/subscriptions) is Phase 4 and deliberately absent;
// the schema leaves clean seams (Session relates to Vendor directly for now).
// ─────────────────────────────────────────────

enum GarmentStatus {
  UPLOADED
  QC_PASSED
  QC_FAILED
  ANALYZED
}

enum GarmentImageRole {
  FRONT
  BACK
  OPEN
  SLEEVE
  EMBROIDERY
  BUTTON
  FABRIC
  LOGO
  COLLAR
  BELT
  POCKET
  DETAIL
}

enum StudioSessionStatus {
  DRAFT
  RUNNING
  PREVIEW
  APPROVED
  PUBLISHED
  REVIEW_REQUIRED
  FAILED
  CANCELLED
}

enum GenerationJobKind {
  ANALYZE
  IMAGE
  VIDEO
  FIDELITY
  PUBLISH
}

enum GenerationJobState {
  QUEUED
  VALIDATING
  ANALYZING
  GENERATING_IMAGES
  VALIDATING_IMAGES
  GENERATING_VIDEO
  VALIDATING_VIDEO
  COMPLETED
  FAILED
  REVIEW_REQUIRED
  CANCELLED
}

enum GeneratedAssetType {
  IMAGE_FRONT
  IMAGE_BACK
  IMAGE_34_FRONT
  IMAGE_34_BACK
  VIDEO_TURNTABLE
}

// ───────── Garment intelligence ─────────
model GarmentAsset {
  id         String        @id @default(uuid())
  vendorId   String // seller/org isolation anchor (→ Vendor)
  productId  String? // optional link to an existing Product
  status     GarmentStatus @default(UPLOADED)
  category   String?
  silhouette String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  vendor   Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product  Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  images   GarmentImage[]
  analysis GarmentAnalysis?
  sessions GenerationSession[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@index([productId])
}

model GarmentImage {
  id         String           @id @default(uuid())
  garmentId  String
  role       GarmentImageRole
  storageKey String // object-storage key (never bytes)
  width      Int?
  height     Int?
  qcPassed   Boolean          @default(false)
  qcIssues   Json             @default("[]") // actionable QC errors
  createdAt  DateTime         @default(now())

  garment GarmentAsset @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
  @@index([garmentId, role])
}

model GarmentAnalysis {
  id                String   @id @default(uuid())
  garmentId         String   @unique
  colors            Json     @default("[]") // [{name,hex,coverage}]
  material          String?
  pattern           String?
  length            String?
  sleeve            String?
  neckline          String?
  closure           String?
  buttons           Json     @default("{}")
  embroidery        Json     @default("{}")
  logo              Json     @default("{}")
  pockets           Json     @default("{}")
  belt              Json     @default("{}")
  segmentationMasks Json     @default("[]") // storage keys for masks
  detailCrops       Json     @default("[]") // storage keys for crops
  embeddings        Json     @default("{}") // {model, dim, vectorRef}
  modelName         String // which analyzer produced this
  createdAt         DateTime @default(now())

  garment GarmentAsset @relation(fields: [garmentId], references: [id], onDelete: Cascade)
}

// ───────── Model library ─────────
model AIModelProfile {
  id            String   @id @default(uuid())
  vendorId      String? // null = platform-shared model
  name          String
  descriptor    Json     @default("{}") // synthetic identity (NO real person)
  referenceKeys Json     @default("[]") // storage keys of locked identity references
  seed          BigInt?
  isActive      Boolean  @default(true)
  isShared      Boolean  @default(false)
  createdAt     DateTime @default(now())

  vendor   Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sessions GenerationSession[]

  @@index([vendorId])
  @@index([isShared, isActive])
}

// ───────── Generation session (the consistency anchor) ─────────
model GenerationSession {
  id             String              @id @default(uuid())
  vendorId       String // seller/org isolation anchor
  garmentId      String
  modelProfileId String?
  productId      String?
  status         StudioSessionStatus @default(DRAFT)
  seed           BigInt?
  referenceKeys  Json                @default("[]") // locked try-on composite + garment refs
  lighting       Json                @default("{}")
  environment    Json                @default("{}")
  camera         Json                @default("{}")
  backgroundId   String?
  provider       String? // chosen primary provider id (audit)
  providerParams Json                @default("{}")
  resolution     String?
  correlationId  String? // links request→session→jobs→provider→assets
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  vendor       Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  garment      GarmentAsset     @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  modelProfile AIModelProfile?  @relation(fields: [modelProfileId], references: [id], onDelete: SetNull)
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  jobs         GenerationJob[]
  assets       GeneratedAsset[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@index([garmentId])
}

// ───────── Jobs (async; first real consumer of the outbox) ─────────
model GenerationJob {
  id             String             @id @default(uuid())
  sessionId      String
  kind           GenerationJobKind
  state          GenerationJobState @default(QUEUED)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(3)
  idempotencyKey String             @unique
  availableAt    DateTime           @default(now())
  provider       String?
  providerRef    String? // external job id
  error          String?
  correlationId  String // links request→session→jobs→provider→assets
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  session GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([state, availableAt])
  @@index([sessionId])
  @@index([correlationId])
}

model GeneratedAsset {
  id            String             @id @default(uuid())
  sessionId     String
  type          GeneratedAssetType
  storageKey    String
  cdnUrl        String? // set only after publish
  provider      String
  providerModel String
  width         Int?
  height        Int?
  durationSec   Decimal?           @db.Decimal(5, 2)
  c2paSigned    Boolean            @default(false)
  isSimulated   Boolean            @default(false) // placeholder output — never publishable in prod
  createdAt     DateTime           @default(now())

  session GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, type])
}

// ───────── Provider registry (seam for the Phase-4 cost router) ─────────
model Provider {
  id          String  @id @default(uuid())
  code        String  @unique // fashn | flux2 | veo3 | kling | rekognition | claude-vision
  displayName String
  operations  Json    @default("[]") // ["TRYON","MULTIVIEW","VIDEO","FIDELITY","MODERATION"]
  isActive    Boolean @default(true)
  config      Json    @default("{}") // non-secret config; keys live in Key Vault

  models ProviderModel[]
}

model ProviderModel {
  id          String  @id @default(uuid())
  providerId  String
  modelCode   String // e.g. "fashn/tryon/v1.6"
  operation   String
  unitCost    Decimal @db.Decimal(10, 6) // per image / per second / per MP
  unit        String // IMAGE | SECOND | MEGAPIXEL | CALL
  minPlanTier String?
  isActive    Boolean @default(true)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelCode])
}

// ─────────────────────────────────────────────
// AI FASHION STUDIO — Phase 4 (MONETIZATION)
//
// Hybrid model: subscription tiers grant included "AI Shoots" + credit packs
// for overage. The "AI Shoot" is the billing unit (GPU/token internals hidden).
// Plan/pack params are config-in-DB (admin-editable, never hard-coded). Money is
// Decimal, never float. Credit ledger is APPEND-ONLY (ADR-0003). Everything is
// keyed to vendorId for strict seller isolation (consistent with Phase 1, which
// relates GenerationSession → Vendor directly rather than an AIStudioSeller layer).
// ─────────────────────────────────────────────

enum StudioSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  EXPIRED
}

enum StudioBillingCycle {
  MONTHLY
  ANNUAL
}

enum CreditTxnType {
  GRANT // subscription-included shoots granted at activation/renewal
  PURCHASE // credit-pack purchase
  RESERVE // shoot reserved at generation start (signed −)
  CONSUME // shoot consumed on delivery/approval
  RELEASE // reservation released (platform failure / cancel) (signed +)
  EXPIRE // unused credits expired
  ADJUST // manual admin correction (reversing entry)
  ROLLOVER // carried from a prior period
}

enum StudioPaymentKind {
  SUBSCRIPTION
  CREDIT_PACK
}

enum StudioPaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// Plans are config-in-DB — admin edits price/includedShoots/limits without deploy.
model SubscriptionPlan {
  id                 String   @id @default(uuid())
  code               String   @unique // TRY BOUTIQUE PROFESSIONAL BRAND ENTERPRISE
  name               String
  priceMonthly       Decimal  @db.Decimal(10, 2)
  priceAnnual        Decimal? @db.Decimal(10, 2)
  currency           String   @default("AED")
  includedShoots     Int
  maxResolution      String   @default("2K") // "2K" | "4K"
  allowedModels      Json     @default("[]") // provider/model allowlist for this tier
  downloadsAllowed   Boolean  @default(true)
  rolloverShoots     Int      @default(0)
  overageCreditPrice Decimal? @db.Decimal(10, 2)
  monthlyLimit       Int? // null = unlimited overage
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions StudioSubscription[]
}

model StudioSubscription {
  id                   String                   @id @default(uuid())
  vendorId             String                   @unique
  planId               String
  status               StudioSubscriptionStatus @default(ACTIVE)
  billingCycle         StudioBillingCycle       @default(MONTHLY)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?
  cancelAtPeriodEnd    Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  vendor Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([currentPeriodEnd])
}

model CreditWallet {
  id               String   @id @default(uuid())
  vendorId         String   @unique
  available        Decimal  @default(0) @db.Decimal(12, 2) // shoots available
  reserved         Decimal  @default(0) @db.Decimal(12, 2) // shoots reserved by in-flight generations
  lifetimeConsumed Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([vendorId])
}

// APPEND-ONLY (ADR-0003): rows never UPDATE/DELETE; corrections are ADJUST entries.
model CreditTransaction {
  id             String        @id @default(uuid())
  walletId       String
  vendorId       String // denormalized for scoped queries + isolation
  type           CreditTxnType
  amount         Decimal       @db.Decimal(12, 2) // signed
  balanceAfter   Decimal       @db.Decimal(12, 2) // available snapshot after this entry
  sessionId      String?
  jobId          String?
  paymentId      String?
  idempotencyKey String        @unique
  reason         String?
  actor          String? // "system" | "webhook" | adminUserId
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([vendorId])
  @@index([walletId, createdAt])
  @@index([sessionId])
}

model CreditPackage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("AED")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Studio billing payments (subscriptions + packs). Mirrors PaymentTransaction
// discipline: order-first, idempotent webhook reconcile (duplicate ≠ double-credit).
model StudioPayment {
  id             String              @id @default(uuid())
  vendorId       String
  kind           StudioPaymentKind
  status         StudioPaymentStatus @default(PENDING)
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("AED")
  method         String              @default("CARD")
  // what this payment grants on capture:
  planId         String? // for SUBSCRIPTION
  billingCycle   StudioBillingCycle? // for SUBSCRIPTION
  packageId      String? // for CREDIT_PACK
  grantedCredits Int                 @default(0) // packs: pack.credits; subs: plan.includedShoots
  externalRef    String?
  idempotencyKey String              @unique
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  invoice StudioInvoice?

  @@index([vendorId])
  @@index([status])
}

// UAE 5% VAT tax invoice for a Studio payment (AYVANA is the seller to the vendor).
// Plan/pack prices are treated VAT-EXCLUSIVE (B2B SaaS) → VAT added on top.
model StudioInvoice {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  invoiceNumber String   @unique
  sellerName    String   @default("AYVANA")
  sellerTRN     String?
  buyerName     String
  buyerTRN      String?
  subtotal      Decimal  @db.Decimal(10, 2) // net
  vatRate       Decimal  @default(0.05) @db.Decimal(4, 2)
  vatAmount     Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  lines         Json     @default("[]")
  externalRef   String?
  issuedAt      DateTime @default(now())

  payment StudioPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

// REAL variable cost per shoot → margin engine. One row per session.
model GenerationCost {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  vendorId          String // denormalized for per-vendor/plan aggregation
  planCode          String? // the vendor's plan at shoot time (revenue allocation basis)
  provider          String
  model             String
  images            Int      @default(0)
  retries           Int      @default(0)
  videoSeconds      Decimal  @default(0) @db.Decimal(6, 2)
  resolution        String?
  tokens            Int      @default(0)
  gpuCost           Decimal  @default(0) @db.Decimal(10, 6)
  storageCost       Decimal  @default(0) @db.Decimal(10, 6)
  cdnCost           Decimal  @default(0) @db.Decimal(10, 6)
  moderationCost    Decimal  @default(0) @db.Decimal(10, 6)
  qaCost            Decimal  @default(0) @db.Decimal(10, 6)
  totalVariableCost Decimal  @db.Decimal(10, 4)
  sellerRevenue     Decimal? @db.Decimal(10, 2) // allocated plan/pack revenue for this shoot
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([vendorId])
  @@index([planCode])
}

// Per-provider-call usage (one row per provider operation in a shoot).
model ProviderUsage {
  id            String   @id @default(uuid())
  sessionId     String?
  jobId         String?
  providerCode  String
  model         String
  operation     String // TRYON | MULTIVIEW | VIDEO | FIDELITY | MODERATION | ANALYZE
  units         Decimal  @db.Decimal(12, 4) // images / seconds / MP
  cost          Decimal  @db.Decimal(10, 6)
  latencyMs     Int?
  success       Boolean  @default(true)
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([providerCode, createdAt])
  @@index([sessionId])
  @@index([operation])
}
