{
  "name": "ayvana",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:push": "turbo db:push",
    "db:generate": "turbo db:generate",
    "db:seed": "turbo run db:seed --filter=@ayvana/db",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.4.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<8.5.18": ">=8.5.18",
      "js-cookie@<3.0.7": ">=3.0.7",
      "jsondiffpatch@<0.7.6": ">=0.7.6"
    }
  }
}
